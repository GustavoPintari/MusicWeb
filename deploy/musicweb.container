# Quadlet for rootless Podman: ~/.config/containers/systemd/musicweb.container
#   systemctl --user daemon-reload && systemctl --user start musicweb
# Web page on 127.0.0.1:8095 (publish it with: tailscale serve --bg --https=8451 http://127.0.0.1:8095).
# The "Receiver" output plays through the server's PipeWire (user service, see the README), which owns the sound card
# and mixes MusicWeb with anything else sent to it. The container only needs PipeWire's socket.

[Unit]
Description=MusicWeb (player web; saída Receiver pelo PipeWire do servidor)
Wants=network-online.target pipewire.socket
After=network-online.target pipewire.socket wireplumber.service

[Container]
ContainerName=musicweb
Image=localhost/musicweb:latest
PublishPort=127.0.0.1:8095:8095
Timezone=local
# PipeWire's socket from the user's runtime dir (%t = /run/user/<uid>); mpv talks to it with --ao=pipewire
Volume=%t/pipewire-0:/run/pipewire/pipewire-0
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
# no SELinux on Debian, so this changes nothing there; on Fedora/RHEL it is what lets the container open the socket
SecurityLabelDisable=true
# init process: reaps mpv and passes on SIGTERM
PodmanArgs=--init
Volume=/srv/media/music:/music
Volume=/srv/media/.musicweb-lixeira:/trash
Volume=/storage/apps/musicweb/data:/data
Volume=/storage/apps/musicweb/cache:/cache
# optional: your own config (copy deploy/config.server.toml there first)
# Volume=/storage/apps/musicweb/config.toml:/etc/musicweb/config.toml:ro

[Service]
ExecStartPre=/usr/local/sbin/wait-for-network.sh
ExecStartPre=/usr/bin/mountpoint -q /srv/media
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
